# ==========================================
# VARIABLES DE ENTORNO PARA DESPLIEGUE EN RENDER
# ==========================================

# Configuración del Servidor Express
PORT=4000
NODE_ENV=production
JWT_SECRET=tu_jwt_secret_token_seguro_aqui_2026

# Configuración de Base de Datos PostgreSQL con SSL (Render)
DB_USER=tu_usuario_postgres
DB_PASSWORD=tu_password_postgres_seguro
DB_HOST=tu_host_postgres.render.com
DB_PORT=5432
DB_NAME=tu_nombre_base_datos
DB_SSL=true

# Para producción, Render automáticamente añade SSL
# Si usas otra plataforma, configura SSL así:
# DB_SSL_CA=/path/to/ca-certificate.crt
# DB_SSL_KEY=/path/to/client-key.pem  
# DB_SSL_CERT=/path/to/client-cert.pem

# Configuración de Stripe (Producción)
STRIPE_SECRET_KEY=sk_live_tu_clave_secreta_stripe
STRIPE_PUBLISHABLE_KEY=pk_live_tu_clave_publica_stripe

# Configuración de CORS para producción
FRONTEND_URL=https://tu-app.netlify.app
# O si usas dominio personalizado:
# FRONTEND_URL=https://tudominio.com

# Configuración de Seguridad
SESSION_SECRET=tu_session_secret_seguro
BCRYPT_ROUNDS=12

# Configuración de Logs
LOG_LEVEL=info
LOG_TO_FILE=true

# Configuración de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutos
RATE_LIMIT_MAX_REQUESTS=100